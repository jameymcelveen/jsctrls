{
    "name": "jsctrls/names-api",
    "description": "The jsctrls demo names API (specs/006-names-api) in PHP, with Slim 4.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "slim/slim": "4.15.3",
        "slim/psr7": "1.8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "13.4.7"
    },
    "autoload": {
        "psr-4": { "Names\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Names\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
